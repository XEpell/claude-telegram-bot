+    if (c.status !== 'allowed') kb.text(`✅ ${short(c)}`, `bizl:allow:${id}`)
+    if (c.status !== 'denied') kb.text(`❌ ${short(c)}`, `bizl:deny:${id}`)
+    kb.row()
+    rows++
+  }
