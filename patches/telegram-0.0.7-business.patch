+function saveBiz(b: Record<string, BizConn>): void {
+  mkdirSync(STATE_DIR, { recursive: true, mode: 0o700 })
+  const tmp = BUSINESS_FILE + '.tmp'
+  writeFileSync(tmp, JSON.stringify(b, null, 2) + '\n', { mode: 0o600 })
+  renameSync(tmp, BUSINESS_FILE)
+}
