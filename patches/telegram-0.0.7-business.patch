+
+// [custom] Token usage of the bot's Claude Code session. Claude Code writes a
+// transcript per session to ~/.claude/projects/<encoded folder>/*.jsonl, with
+// `usage` on every model response. We sum it per local day and keep the totals
+// in usage-stats.json (+ a CSV copy), so the history survives even after
+// Claude Code cleans up old transcripts. The folder is the one Claude Code is
+// started in (hotkey launcher: ~/claude-telegram); override with
+// "usageDir" in business-settings.json.
+type Tok = { input: number; output: number; cacheWrite: number; cacheRead: number; requests: number }
+type UsageStore = { version: 1; updatedAt: string; days: Record<string, Record<string, Tok>> }
+const USAGE_FILE = join(STATE_DIR, 'usage-stats.json')
+const USAGE_CSV = join(STATE_DIR, 'usage-stats.csv')
+const usageFileCache = new Map<string, { mtime: number; size: number; perDay: Record<string, Tok> }>()
+
+function usageProjectDir(): string {
+  let dir = join(homedir(), 'claude-telegram')
+  try {
+    const s = JSON.parse(readFileSync(BIZ_SETTINGS_FILE, 'utf8'))
+    if (typeof s?.usageDir === 'string' && s.usageDir.trim()) dir = s.usageDir.trim()
+  } catch {}
+  return join(homedir(), '.claude', 'projects', dir.replace(/[^A-Za-z0-9]/g, '-'))
+}
+
+const zeroTok = (): Tok => ({ input: 0, output: 0, cacheWrite: 0, cacheRead: 0, requests: 0 })
+const tokTotal = (t: Tok) => t.input + t.output + t.cacheWrite + t.cacheRead
+function addTok(a: Tok, b: Tok): Tok {
+  return { input: a.input + b.input, output: a.output + b.output, cacheWrite: a.cacheWrite + b.cacheWrite, cacheRead: a.cacheRead + b.cacheRead, requests: a.requests + b.requests }
+}
+function localDay(d: Date): string {
+  const p = (n: number) => String(n).padStart(2, '0')
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`
+}
+
+function listTranscripts(dir: string, rel = ''): string[] {
+  const out: string[] = []
+  let entries: import('fs').Dirent[] = []
+  try { entries = readdirSync(join(dir, rel), { withFileTypes: true }) } catch { return out }
+  for (const e of entries) {
+    const r = rel ? join(rel, e.name) : e.name
+    if (e.isDirectory() && e.name !== 'memory' && rel.split(sep).length < 3) out.push(...listTranscripts(dir, r))
+    else if (e.isFile() && e.name.endsWith('.jsonl')) out.push(r)
+  }
+  return out
+}
+
+function parseTranscript(path: string): Record<string, Tok> {
+  const perDay: Record<string, Tok> = {}
+  const seen = new Set<string>()
+  let raw = ''
+  try { raw = readFileSync(path, 'utf8') } catch { return perDay }
+  for (const line of raw.split('\n')) {
+    if (!line.includes('"usage"')) continue
+    let o: any
+    try { o = JSON.parse(line) } catch { continue }
+    const u = o?.message?.usage
+    if (o?.type !== 'assistant' || !u || typeof o.timestamp !== 'string') continue
+    if (o.message.model === '<synthetic>') continue
+    // One response is written as several lines (one per content block) with the same usage.
+    const key = `${o.message.id ?? ''}:${o.requestId ?? ''}`
+    if (key !== ':' && seen.has(key)) continue
+    seen.add(key)
+    const t = new Date(o.timestamp)
+    if (isNaN(t.getTime())) continue
+    const day = localDay(t)
+    const n = (v: unknown) => (typeof v === 'number' && isFinite(v) && v > 0 ? v : 0)
+    perDay[day] = addTok(perDay[day] ?? zeroTok(), {
+      input: n(u.input_tokens), output: n(u.output_tokens),
+      cacheWrite: n(u.cache_creation_input_tokens), cacheRead: n(u.cache_read_input_tokens), requests: 1,
+    })
+  }
+  return perDay
+}
+
+function readUsageStore(): UsageStore {
+  try {
+    const s = JSON.parse(readFileSync(USAGE_FILE, 'utf8'))
+    if (s && s.version === 1 && s.days && typeof s.days === 'object') return s
+  } catch {}
+  return { version: 1, updatedAt: '', days: {} }
+}
+
+function writeUsageStore(store: UsageStore): void {
+  const write = (file: string, body: string) => {
+    const tmp = file + '.tmp'
+    try {
+      writeFileSync(tmp, body)
+      try { renameSync(tmp, file) } catch { writeFileSync(file, body); rmSync(tmp, { force: true }) }
+    } catch (err) {
+      process.stderr.write(`telegram channel: could not save ${file}: ${err}\n`)
+    }
+  }
+  write(USAGE_FILE, JSON.stringify(store, null, 1) + '\n')
+  const rows = ['date,total,input,output,cache_write,cache_read,requests']
+  for (const day of Object.keys(store.days).sort()) {
+    const t = Object.values(store.days[day]).reduce(addTok, zeroTok())
+    rows.push([day, tokTotal(t), t.input, t.output, t.cacheWrite, t.cacheRead, t.requests].join(','))
+  }
+  write(USAGE_CSV, rows.join('\n') + '\n')
+}
+
+// Rescan changed transcripts and merge them into the long-term store.
+function refreshUsage(): UsageStore {
+  const store = readUsageStore()
+  const dir = usageProjectDir()
+  for (const rel of listTranscripts(dir)) {
+    const path = join(dir, rel)
+    let st: import('fs').Stats
+    try { st = statSync(path) } catch { continue }
+    let c = usageFileCache.get(path)
+    if (!c || c.mtime !== st.mtimeMs || c.size !== st.size) {
+      c = { mtime: st.mtimeMs, size: st.size, perDay: parseTranscript(path) }
+      usageFileCache.set(path, c)
+    }
+    const key = rel.replace(/\\/g, '/').replace(/\.jsonl$/, '')
+    for (const [day, t] of Object.entries(c.perDay)) (store.days[day] ??= {})[key] = t
+  }
+  store.updatedAt = new Date().toISOString()
+  writeUsageStore(store)
+  return store
+}
+
+function fmtTok(n: number): string {
+  const f = (x: number) => x.toFixed(x >= 100 ? 0 : 1).replace('.', ',').replace(/,0$/, '')
+  if (n >= 1e9) return `${f(n / 1e9)} млрд`
+  if (n >= 1e6) return `${f(n / 1e6)} млн`
+  if (n >= 1e3) return `${f(n / 1e3)} тыс.`
+  return String(n)
+}
+
+function statsView(): { text: string; kb: InlineKeyboard } {
+  const store = refreshUsage()
+  const dayTotal = (day: string) => Object.values(store.days[day] ?? {}).reduce(addTok, zeroTok())
+  const now = new Date()
+  const last7: string[] = []
+  for (let i = 0; i < 7; i++) last7.push(localDay(new Date(now.getFullYear(), now.getMonth(), now.getDate() - i)))
+  const today = dayTotal(last7[0])
+  const week = last7.map(dayTotal).reduce(addTok, zeroTok())
+  const allDays = Object.keys(store.days).sort()
+  const all = allDays.map(dayTotal).reduce(addTok, zeroTok())
+  const dayLabel = (day: string) => {
+    const [y, m, d] = day.split('-').map(Number)
+    return new Date(y, m - 1, d).toLocaleDateString('ru-RU', { weekday: 'short', day: 'numeric', month: 'short' })
+  }
+  const block = (title: string, t: Tok) =>
+    `${title}: ${fmtTok(tokTotal(t))}\n` +
+    `   ✍️ ответы модели: ${fmtTok(t.output)}\n` +
+    `   📥 новый ввод: ${fmtTok(t.input + t.cacheWrite)}\n` +
+    `   ♻️ из кэша: ${fmtTok(t.cacheRead)}\n` +
+    `   🔁 запросов к модели: ${t.requests}`
+  const text =
+    `📊 Расход токенов бота\n\n` +
+    block(`Сегодня (${dayLabel(last7[0])})`, today) + '\n\n' +
+    block('За 7 дней', week) + '\n\n' +
+    `По дням:\n` +
+    last7.map(d => `• ${dayLabel(d)} — ${fmtTok(tokTotal(dayTotal(d)))}`).join('\n') + '\n\n' +
+    (allDays.length ? `Всего с ${dayLabel(allDays[0])}: ${fmtTok(tokTotal(all))}\n\n` : '') +
+    memoryLine() + '\n\n' +
+    `«Из кэша» — повторно прочитанный контекст, он обходится намного дешевле нового ввода.\n` +
+    `Время: ${nowLabel()}`
+  const kb = new InlineKeyboard().text('🔄 Обновить', 'stats:refresh')
+  if (relaunchable) kb.text('♻️ Очистить память сейчас', 'stats:reset')
+  return { text, kb }
+}
+
+function memoryLine(): string {
+  const limit = memoryResetTokens()
+  const s = sessionContext()
+  const now = s ? `сейчас ${fmtTok(s.tokens)} токенов` : 'размер пока неизвестен'
+  if (!relaunchable) return `🧠 Память сессии: ${now}. Автоочистка выключена (бот запущен не через Alt+Win+F5 / автозапуск).`
+  if (!limit) return `🧠 Память сессии: ${now}. Автоочистка выключена в настройках.`
+  return `🧠 Память сессии: ${now}; очистится сама при ~${fmtTok(limit)} в спокойный момент.`
+}
+
+bot.command('stats', async ctx => {
+  const gated = dmCommandGate(ctx)
+  if (!gated || !gated.access.allowFrom.includes(gated.senderId)) return
+  let view: { text: string; kb: InlineKeyboard }
+  try { view = statsView() } catch (err) {
+    await ctx.reply(`Не удалось посчитать статистику: ${err instanceof Error ? err.message : err}`)
+    return
+  }
+  await ctx.reply(view.text, { reply_markup: view.kb })
+})
+
+// Keep the long-term file up to date even when /stats isn't used.
+if (POLL) {
+  setTimeout(() => { try { refreshUsage() } catch {} }, 60_000).unref()
+  setInterval(() => { try { refreshUsage() } catch {} }, 60 * 60_000).unref()
+}
+
+// ---------------------------------------------------------------------------
+// [custom] Planned memory reset. The Claude Code session keeps everything since
+// it started in its context and re-reads it for every message, so cost grows
+// with uptime. When the context gets big and the chats are quiet, we ask the
+// launcher loop (hotkey/run-bot.ps1) for a restart: write restart.request and
+// end the channels claude.exe; the loop starts a fresh session. Durable state
+// lives in files, so nothing important is lost.
+// ---------------------------------------------------------------------------
+
+const RESTART_REQUEST = join(STATE_DIR, 'restart.request')
+const RESTART_QUIET = join(STATE_DIR, 'restart.quiet')
+const STARTED_AT = Date.now()
+const DEFAULT_RESET_TOKENS = 120_000
+let plannedRestart = false
+
+function memoryResetTokens(): number {
+  try {
+    const v = JSON.parse(readFileSync(BIZ_SETTINGS_FILE, 'utf8'))?.memoryResetTokens
+    if (typeof v === 'number' && v >= 0) return v
+  } catch {}
+  return DEFAULT_RESET_TOKENS
+}
+
+// Context size of THIS session: the last model call in the newest transcript
+// that was created after this server started.
+function sessionContext(): { tokens: number; idleMs: number } | null {
+  const dir = usageProjectDir()
+  let best: { path: string; mtime: number; birth: number } | null = null
+  let entries: string[] = []
+  try { entries = readdirSync(dir) } catch { return null }
+  for (const f of entries) {
+    if (!f.endsWith('.jsonl')) continue
+    try {
+      const st = statSync(join(dir, f))
+      if (!best || st.mtimeMs > best.mtime) best = { path: join(dir, f), mtime: st.mtimeMs, birth: st.birthtimeMs || st.ctimeMs }
+    } catch {}
+  }
+  if (!best || best.birth < STARTED_AT - 5 * 60_000) return null // not ours (yet)
+  let fd = -1
+  try {
+    fd = openSync(best.path, 'r')
+    const size = statSync(best.path).size
+    const len = Math.min(size, 512 * 1024)
+    const buf = Buffer.alloc(len)
+    readSync(fd, buf, 0, len, size - len)
+    const lines = buf.toString('utf8').split('\n')
+    for (let i = lines.length - 1; i >= (len < size ? 1 : 0); i--) {
+      const line = lines[i]!
+      if (!line.includes('"usage"')) continue
+      try {
+        const o = JSON.parse(line)
+        const u = o?.message?.usage
+        if (o?.type !== 'assistant' || o.isSidechain || !u) continue
+        const tokens = (u.input_tokens ?? 0) + (u.cache_creation_input_tokens ?? 0) + (u.cache_read_input_tokens ?? 0)
+        return { tokens, idleMs: Date.now() - best.mtime }
+      } catch {}
+    }
+  } catch {} finally { if (fd >= 0) try { closeSync(fd) } catch {} }
+  return null
+}
+
+// Why a restart would interrupt something right now (null = safe).
+function restartBlocker(): string | null {
+  const now = Date.now()
+  for (const v of bizInbound.values()) if (now - v.at < 10 * 60_000) return 'бот ещё отвечает на сообщение'
+  if (profileTasks.size) return 'бот обновляет карточку'
+  if (now - lastBizAt < 3 * 60_000) return 'в чатах идёт переписка'
+  return null
+}
+
+async function planRestart(tokens: number): Promise<string | null> {
+  if (!relaunchable || !claudePid) return 'бот запущен не через Alt+Win+F5 / автозапуск — перезапустить сам не может'
+  if (plannedRestart) return 'уже перезапускаюсь'
+  plannedRestart = true
+  try {
+    writeFileSync(RESTART_QUIET, JSON.stringify({ at: Date.now(), tokens }))
+    writeFileSync(RESTART_REQUEST, String(Date.now()))
+  } catch (err) {
+    plannedRestart = false
+    return `не удалось записать файл: ${err}`
+  }
+  await Promise.race([
+    notifyOwners(`♻️ Очищаю память сессии${tokens ? ` (${fmtTok(tokens)} токенов)` : ''}. Бот вернётся примерно через полминуты.`, true),
+    new Promise(r => setTimeout(r, 3000)),
+  ])
+  try {
+    execFileSync('taskkill', ['/PID', String(claudePid), '/F'], { stdio: 'ignore', windowsHide: true, timeout: 15000 })
+  } catch (err) {
+    plannedRestart = false
+    try { rmSync(RESTART_REQUEST, { force: true }); rmSync(RESTART_QUIET, { force: true }) } catch {}
+    return `не удалось перезапустить: ${err}`
+  }
+  return null
+}
+
+function checkMemory(): void {
+  if (!POLL || !relaunchable || plannedRestart || shuttingDown) return
+  const limit = memoryResetTokens()
+  if (!limit || Date.now() - STARTED_AT < 15 * 60_000) return
+  const ctxInfo = sessionContext()
+  if (!ctxInfo || ctxInfo.tokens < limit) return
+  if (ctxInfo.idleMs < 90_000 || restartBlocker()) return // wait for a quiet moment
+  void planRestart(ctxInfo.tokens).then(err => {
+    if (err) process.stderr.write(`telegram channel: memory reset failed: ${err}\n`)
+  })
+}
+
+if (POLL) {
+  setInterval(checkMemory, 2 * 60_000).unref()
+  setInterval(() => { try { runProfileTasks() } catch (err) { process.stderr.write(`telegram channel: profile tasks: ${err}\n`) } }, 2 * 60_000).unref()
+  setInterval(() => { void checkReminders().catch(() => {}) }, 30_000).unref()
+}
+
