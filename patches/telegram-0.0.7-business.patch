+// Connections made while the server was down never reached us — ask Telegram.
+async function resolveBiz(connId: string): Promise<BizConn | null> {
+  const known = readBiz()[connId]
+  if (known) return known
+  try {
+    const c = await bot.api.getBusinessConnection(connId)
+    const conn: BizConn = {
+      ownerId: String(c.user.id),
+      enabled: c.is_enabled,
+      canReply: !!c.rights?.can_reply,
+    }
+    const all = readBiz()
+    all[connId] = conn
+    saveBiz(all)
+    return conn
+  } catch {
+    return null
+  }
