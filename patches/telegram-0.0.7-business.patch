+// [custom] Retries on network failures and Telegram flood limits (429).
+// Other API errors (bad request, no rights…) are thrown at once.
+async function withRetry<T>(fn: () => Promise<T>, tries = 4): Promise<T> {
+  let last: unknown
+  for (let i = 0; i < tries; i++) {
+    try {
+      return await fn()
+    } catch (err) {
+      last = err
+      const is429 = err instanceof GrammyError && err.error_code === 429
+      if (err instanceof GrammyError && !is429) throw err
+      const wait = is429 ? ((err as GrammyError).parameters?.retry_after ?? 3) * 1000 : 1500 * (i + 1)
+      await new Promise(r => setTimeout(r, wait))
+    }
+  }
+  throw last
+}
