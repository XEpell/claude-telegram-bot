+  '\\b[\\w-]+\\.(?:[a-z]{2,}|рф)\\b',   // anything that looks like a domain or file
+  '\\d[\\d\\s\\-().]{3,}\\d',           // phone/card/code, also split by spaces/dashes
+  '\\d{3,}',
+  '\\d{1,2}[:.]\\d{2}',                 // times and dates are facts, not small talk
