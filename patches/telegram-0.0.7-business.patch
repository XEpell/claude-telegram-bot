+const MAX_MEDIA_DOWNLOAD = 20 * 1024 * 1024 // Bot API download cap
+
+type HistDir = 'in' | 'owner' | 'bot'
+type HistMedia = { kind: string; file_id: string; name?: string; path?: string }
+type HistRecord =
+  | { event: 'message'; id: number; dir: HistDir; at: string; text: string; media?: HistMedia; name?: string; thread?: number }
+  | { event: 'edit'; id: number; at: string; text: string }
+  | { event: 'media_saved'; id: number; path: string }
+  | { event: 'delete'; id: number; at: string }
+
+function histFile(chatId: string): string {
+  return join(HISTORY_DIR, `${chatId}.jsonl`)
+}
+
+type HistMsg = HistRecord & { event: 'message' } & { deleted?: boolean }
+
+// Applies one record to a chat's message map. Duplicate message records
+// (redelivery) are collapsed to the first one.
+function applyHist(out: Map<number, HistMsg>, r: HistRecord): void {
+  const cur = out.get(r.id)
+  if (r.event === 'message') {
+    if (!cur) out.set(r.id, { ...r, ...(r.media ? { media: { ...r.media } } : {}) })
+  } else if (cur && r.event === 'edit') cur.text = r.text
+  else if (cur && r.event === 'media_saved' && cur.media) cur.media.path = r.path
+  else if (cur && r.event === 'delete') cur.deleted = true
+}
+
+// Parsed once per chat per process, then kept up to date by appendHist.
+const histCache = new Map<string, Map<number, HistMsg>>()
+
+function appendHist(chatId: string, rec: HistRecord): void {
+  const cached = histCache.get(chatId)
+  if (cached) applyHist(cached, rec)
+  try {
+    mkdirSync(HISTORY_DIR, { recursive: true, mode: 0o700 })
+    appendFileSync(histFile(chatId), JSON.stringify(rec) + '\n', { mode: 0o600 })
+  } catch (err) {
+    process.stderr.write(`telegram channel: history write failed: ${err}\n`)
+  }
+}
+
+// All stored messages of a chat in order, with edits, saved media and
+// deletions applied.
+function loadHist(chatId: string): Map<number, HistMsg> {
+  const cached = histCache.get(chatId)
+  if (cached) return cached
+  const out = new Map<number, HistMsg>()
+  try {
+    for (const line of readFileSync(histFile(chatId), 'utf8').split('\n')) {
+      if (!line) continue
+      try { applyHist(out, JSON.parse(line) as HistRecord) } catch {}
+    }
+  } catch {}
+  histCache.set(chatId, out)
+  return out
+}
+
+function findHist(chatId: string, id: number): HistMsg | null {
+  return loadHist(chatId).get(id) ?? null
+}
