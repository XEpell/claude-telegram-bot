+// Checks a reply and, if it may go out automatically, RESERVES the slot
+// (counter + loop guard) in the same synchronous step, so concurrent calls
+// cannot all pass the limit. Returns a rollback function, or the reason.
+function reserveAutoReply(incoming: string, reply: string, chatId: string): { rollback: () => void } | string {
+  if (contactsBroken) return 'contact list could not be read'
+  if (incoming.length > AUTO_MAX_LEN) return 'incoming message is long'
+  if (reply.length > AUTO_MAX_LEN) return 'reply is long'
