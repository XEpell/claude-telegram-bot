+  const allowed = by('allowed'), pending = by('pending'), denied = by('denied')
+
+  const section = (title: string, list: [string, ContactEntry][], extra?: (c: ContactEntry) => string) =>
+    `${title} (${list.length}):\n` +
+    (list.length ? list.map(([, c]) => `• ${label(c)}${extra ? extra(c) : ''}`).join('\n') : '— нет')
+
+  const text = clip(
